PORT=5000
NODE_ENV=development

# Server-side only — never exposed to the browser
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (verify against current Google AI docs)
GEMINI_MODEL=gemini-1.5-flash
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App (https://github.com/settings/developers → New OAuth App)
# Homepage URL:        http://localhost:5173
# Authorization callback URL:  http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Optional fallback PAT when user is not logged in (local demos only — prefer OAuth)
GITHUB_TOKEN=

# Frontend origin (for CORS + OAuth redirect after login)
FRONTEND_URL=http://localhost:5173

# Optional comma-separated extra allowed CORS origins
# CORS_ORIGINS=

# Optional defaults used only when no repo is selected in the UI
GITHUB_OWNER=octocat
GITHUB_REPO=Hello-World
